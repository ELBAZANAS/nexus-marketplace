# Copy this file to .env.local and fill in the keys you actually have.
# The shop runs without any of them. The assistant then uses offline commands.

# Google Gemini. Enables open-ended answers in the marketplace assistant.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback model. Used only when GEMINI_API_KEY is empty.
QWEN_API_KEY=

# Optional web search for the assistant.
TAVILY_API_KEY=

# Server port. Defaults to 3000.
PORT=3000
